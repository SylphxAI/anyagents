# syntax=docker/dockerfile:1
# Prebuilt coordinator wrapper referencing the immutable OCI image published by
# `.github/workflows/docker-publish.yml` to GHCR, enabling rapid (<30s) hosting
# rollouts without recompiling the full Rust workspace from source.
