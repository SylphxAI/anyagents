{
  "name": "@sylphx/anyagents",
  "version": "0.1.0",
  "description": "Run any coding agent harness as a long-lived agent on your own machine or server: install and sign in Claude Code, Codex, OpenCode, Gemini CLI and more, keep every agent running, connect each one to Telegram, and see what each one costs. A single Rust binary that runs on your machine.",
  "bin": {
    "anyagents": "bin/anyagents.js"
  },
  "files": [
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@sylphx/anyagents-darwin-arm64": "0.1.0",
    "@sylphx/anyagents-darwin-x64": "0.1.0",
    "@sylphx/anyagents-linux-x64-gnu": "0.1.0",
    "@sylphx/anyagents-linux-arm64-gnu": "0.1.0"
  },
  "keywords": [
    "anyagents",
    "coding-agents",
    "agent-harness",
    "claude-code",
    "codex",
    "opencode",
    "gemini-cli",
    "mcp",
    "model-context-protocol",
    "long-lived-agents",
    "agent-mailbox",
    "telegram",
    "ai-agents",
    "llm",
    "rust",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SylphxAI/anyagents.git",
    "directory": "packages/anyagents"
  },
  "bugs": {
    "url": "https://github.com/SylphxAI/anyagents/issues"
  },
  "author": "Sylphx <hi@sylphx.com> (https://sylphx.com)",
